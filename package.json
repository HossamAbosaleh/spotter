{
  "name": "spotter",
  "version": "0.1.0",
  "description": "Your gym, your data, your AI coach. A free, open-source, client-side launchpad and tracker that bridges lifters to their AI assistant of choice.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/hossamabosaleh/spotter",
  "repository": {
    "type": "git",
    "url": "https://github.com/hossamabosaleh/spotter.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:full": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hookform/resolvers": "^3.10.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "i18next": "^23.16.8",
    "lucide-react": "^0.460.0",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "shadcn": "^4.7.0",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
